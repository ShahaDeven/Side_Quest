# Worker secrets for local dev (gitignored). Its presence stops wrangler from loading .env,
# which holds script-only keys (ANTHROPIC_API_KEY) that must never reach the Worker.
# Step 1.2: fine-grained GitHub token, no scopes (public read only).
GITHUB_TOKEN=

# Keys the per-IP rate-limit hash for proof links (HMAC-SHA256). Any long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Proof-link creation refuses to run without it.
IP_HASH_SECRET=
